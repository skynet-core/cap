# CAP bootstrap, local overrides, and build state
.bootstrap/
**/.cap/config.local.toml
**/.cap/overrides.lock
**/.cap/build/
**/.cap/cache/
**/.cap/private/

# Local editor databases and compiler outputs
compile_commands.json
/.cache/clangd/
/clice.toml
gcm.cache/
*.o
*.obj
*.pcm
*.gcm
*.pch

# Coverage and profiling
*.gcda
*.gcno
*.profraw
*.profdata
/perf.data
/perf.data.old
gmon.out

# Editor extension dependencies and packages
node_modules/
/projects/cap-vscode/dist/
/projects/cap-vscode/*.vsix

# Machine-local credentials and environment files. Keep public templates visible.
.aws/
.gnupg/
.ssh/
.git-credentials
.netrc
id_dsa
id_ecdsa
id_ed25519
id_rsa
*.key
*.p12
*.pfx
*.private.pem
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Legacy .amp hygiene rules
**/.amp/config.local.toml
**/.amp/overrides.lock
**/.amp/build/
**/.amp/cache/
**/.amp/private/
